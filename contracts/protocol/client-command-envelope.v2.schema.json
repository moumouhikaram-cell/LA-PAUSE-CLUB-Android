{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lapauseos.local/contracts/protocol/client-command-envelope.v2.schema.json",
  "title": "LA PAUSE Client Command Envelope V2",
  "type": "object",
  "required": [
    "schemaVersion",
    "protocolVersion",
    "commandId",
    "idempotencyKey",
    "commandType",
    "tenantId",
    "venueId",
    "branchId",
    "actorId",
    "originDeviceId",
    "issuedAt",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "protocolVersion": { "const": "la-pause-client/2" },
    "commandId": { "type": "string", "minLength": 8 },
    "idempotencyKey": { "type": "string", "minLength": 8 },
    "commandType": { "type": "string", "minLength": 3 },
    "entityType": { "type": ["string", "null"] },
    "entityId": { "type": ["string", "null"] },
    "tenantId": { "type": "string", "minLength": 1 },
    "venueId": { "type": "string", "minLength": 1 },
    "branchId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "originDeviceId": { "type": "string", "minLength": 1 },
    "clientType": { "enum": ["ANDROID", "WEB", "DESKTOP", "IOS", "PLAYER", "AGENT", "OTHER"] },
    "baseRevision": { "type": ["integer", "null"], "minimum": 0 },
    "issuedAt": { "type": "integer", "minimum": 1 },
    "correlationId": { "type": ["string", "null"] },
    "causationId": { "type": ["string", "null"] },
    "moduleId": { "type": ["string", "null"] },
    "requiredPermission": { "type": ["string", "null"] },
    "payloadSchemaVersion": { "type": "integer", "minimum": 1, "default": 1 },
    "payload": { "type": "object" }
  }
}
